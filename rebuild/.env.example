# Copy to .env (and to backend/.env for local runs without Docker) and change every secret.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=mk
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=mekanizm
# Used by the backend and Prisma. Inside docker-compose the host is "db".
DATABASE_URL=postgresql://mk:change-me-db-password@localhost:5432/mekanizm?schema=public

# --- Backend ----------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Random string, at least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# true only when the site is served over https (e.g. through the Cloudflare tunnel)
COOKIE_SECURE=false
# true when running behind a reverse proxy / tunnel so the real client IP is used
TRUST_PROXY=false
LOGIN_RATE_LIMIT_MAX=10

# --- Seed (first admin account, created only if that phone doesn't exist) -----
SEED_ADMIN_NAME=المدير
SEED_ADMIN_PHONE=01000000000
SEED_ADMIN_PASSWORD=change-me-admin-password
# Optional demo staff account
SEED_STAFF_NAME=موظف تجربة
SEED_STAFF_PHONE=01100000000
SEED_STAFF_PASSWORD=change-me-staff-password

# --- Frontend ---------------------------------------------------------------
# Where the Next.js server forwards /api/* (inside docker-compose: http://backend:4000)
BACKEND_URL=http://localhost:4000

# --- Optional: Cloudflare Tunnel for access from outside the shop --------------
CLOUDFLARE_TUNNEL_TOKEN=
