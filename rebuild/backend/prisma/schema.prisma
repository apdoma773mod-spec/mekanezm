generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  USER_CREATE
  USER_UPDATE
  USER_DEACTIVATE
  USER_PASSWORD_RESET
  SETTING_UPDATE
  PRODUCT_CREATE
  PRODUCT_UPDATE
  PRODUCT_DELETE
  STOCK_ADJUST
  CONTACT_CREATE
  CONTACT_UPDATE
  CONTACT_DELETE
  INVOICE_CREATE
  INVOICE_UPDATE
  INVOICE_VOID
  PAYMENT_CREATE
  PAYMENT_CANCEL
  RETURN_CREATE
  EXPENSE_CREATE
  EXPENSE_UPDATE
  EXPENSE_DELETE
  DAYBOOK_ADD
  DAYBOOK_UPDATE
  DAYBOOK_DELETE
  DAYBOOK_POST
  DAYBOOK_DELIVER
  DAY_CLOSE
  STOCK_COUNT
}

enum Company {
  MK
  HY
}

enum ContactType {
  CUSTOMER
  SUPPLIER
}

enum InvoiceKind {
  SALE
  PURCHASE
}

enum InvoiceStatus {
  ACTIVE
  VOID
}

enum PayMethod {
  CASH
  INSTAPAY
  WALLET
  TRANSFER
}

enum PaymentDirection {
  IN
  OUT
}

enum ReturnKind {
  SALE
  PURCHASE
}

enum ReturnSettlement {
  CASH
  BALANCE
}

enum StockReason {
  SALE
  PURCHASE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUST
  INVOICE_EDIT
  INVOICE_VOID
  DAYBOOK
  COUNT
}

enum DaybookKind {
  ITEM
  PAY
}

enum DaybookPay {
  CASH
  INSTAPAY
  TRANSFER
  CREDIT
}

model User {
  id           String         @id @default(cuid())
  name         String
  phone        String         @unique
  email        String?        @unique
  passwordHash String
  role         Role           @default(STAFF)
  active       Boolean        @default(true)
  lastLoginAt  DateTime?      @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  tokens       RefreshToken[]
  auditLogs    AuditLog[]
  settings     Setting[]
  stockMoves   StockMove[]
  invoicesMade Invoice[]      @relation("InvoiceCreatedBy")
  invoicesEdit Invoice[]      @relation("InvoiceUpdatedBy")
  invoicesVoid Invoice[]      @relation("InvoiceVoidedBy")
  payments     Payment[]      @relation("PaymentCreatedBy")
  paymentsOff  Payment[]      @relation("PaymentCancelledBy")
  returns      Return[]
  expenses     Expense[]
  daybook      DaybookEntry[]
  closings     DayClosing[]
  counts       StockCount[]
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  familyId   String
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  replacedBy String?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([action])
}

/// Gap-free number sequences: product codes, sale and purchase invoice numbers.
model Counter {
  key   String @id
  value Int    @default(0)
}

model Product {
  id        String         @id @default(cuid())
  /// Never reused, even after the product is deleted (soft delete keeps the row).
  code      String         @unique
  name      String
  barcode   String?        @unique
  category  String         @default("")
  unit      String         @default("قطعة")
  price     Decimal        @default(0) @db.Decimal(14, 2)
  cost      Decimal        @default(0) @db.Decimal(14, 2)
  qty       Decimal        @default(0) @db.Decimal(14, 3)
  minQty    Decimal        @default(0) @db.Decimal(14, 3)
  company   Company        @default(MK)
  note      String         @default("")
  deletedAt DateTime?      @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
  moves     StockMove[]
  items     InvoiceItem[]
  returns   Return[]
  daybook   DaybookEntry[]

  @@index([name])
  @@index([category])
  @@index([company, deletedAt])
}

model StockMove {
  id        String      @id @default(cuid())
  productId String
  qtyChange Decimal     @db.Decimal(14, 3)
  qtyAfter  Decimal     @db.Decimal(14, 3)
  reason    StockReason
  refType   String?
  refId     String?
  note      String      @default("")
  userId    String?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([refType, refId])
}

model Contact {
  id             String      @id @default(cuid())
  type           ContactType
  name           String
  phone          String      @default("")
  address        String      @default("")
  note           String      @default("")
  /// Customer: what they owe us. Supplier: what we owe them. Kept in step with every invoice, payment and return.
  balance        Decimal     @default(0) @db.Decimal(14, 2)
  /// Balance carried over when the contact was added; the first line of the statement.
  openingBalance Decimal     @default(0) @db.Decimal(14, 2)
  deletedAt      DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  invoices       Invoice[]
  payments       Payment[]
  returns        Return[]

  @@index([type, name])
  @@index([phone])
}

model Invoice {
  id          String         @id @default(cuid())
  kind        InvoiceKind
  no          String
  status      InvoiceStatus  @default(ACTIVE)
  company     Company        @default(MK)
  /// Business day in Cairo time.
  date        DateTime       @db.Date
  contactId   String?
  person      String         @default("")
  phone       String         @default("")
  address     String         @default("")
  note        String         @default("")
  subtotal    Decimal        @db.Decimal(14, 2)
  discount    Decimal        @default(0) @db.Decimal(14, 2)
  shipping    Decimal        @default(0) @db.Decimal(14, 2)
  total       Decimal        @db.Decimal(14, 2)
  paid        Decimal        @db.Decimal(14, 2)
  remaining   Decimal        @db.Decimal(14, 2)
  payMethod   PayMethod      @default(CASH)
  /// When one invoice was paid with several methods (the daybook): { "CASH": 100, "INSTAPAY": 50 }.
  paidSplit   Json?
  /// "" for invoices typed in directly, "DAYBOOK" when made by settling the daybook.
  source      String         @default("")
  createdById String?
  updatedById String?
  voidedById  String?
  voidedAt    DateTime?      @db.Timestamptz(3)
  voidReason  String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  contact     Contact?       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  createdBy   User?          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?          @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  voidedBy    User?          @relation("InvoiceVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  items       InvoiceItem[]
  payments    Payment[]
  returns     Return[]
  daybook     DaybookEntry[]

  @@unique([kind, no])
  @@index([kind, date])
  @@index([contactId])
  @@index([status])
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  productId String?
  name      String
  unit      String   @default("قطعة")
  qty       Decimal  @db.Decimal(14, 3)
  price     Decimal  @db.Decimal(14, 2)
  total     Decimal  @db.Decimal(14, 2)
  /// Cost per unit when the line was saved: product cost for a sale, the purchase price for a purchase.
  unitCost  Decimal  @db.Decimal(14, 2)
  position  Int
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id            String           @id @default(cuid())
  contactId     String
  invoiceId     String?
  direction     PaymentDirection
  amount        Decimal          @db.Decimal(14, 2)
  method        PayMethod        @default(CASH)
  company       Company          @default(MK)
  date          DateTime         @db.Date
  note          String           @default("")
  /// False for book-only settlements (e.g. zeroing an account without money changing hands).
  affectsCash   Boolean          @default(true)
  createdById   String?
  cancelledById String?
  cancelledAt   DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  contact       Contact          @relation(fields: [contactId], references: [id], onDelete: Restrict)
  invoice       Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy     User?            @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy   User?            @relation("PaymentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([contactId, date])
  @@index([date])
}

model Return {
  id          String           @id @default(cuid())
  kind        ReturnKind
  productId   String
  contactId   String?
  invoiceId   String?
  person      String           @default("")
  qty         Decimal          @db.Decimal(14, 3)
  price       Decimal          @db.Decimal(14, 2)
  total       Decimal          @db.Decimal(14, 2)
  unitCost    Decimal          @db.Decimal(14, 2)
  settlement  ReturnSettlement @default(CASH)
  method      PayMethod        @default(CASH)
  company     Company          @default(MK)
  date        DateTime         @db.Date
  note        String           @default("")
  createdById String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  contact     Contact?         @relation(fields: [contactId], references: [id], onDelete: Restrict)
  invoice     Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([productId])
}

model Expense {
  id          String    @id @default(cuid())
  category    String    @default("عام")
  amount      Decimal   @db.Decimal(14, 2)
  method      PayMethod @default(CASH)
  company     Company   @default(MK)
  date        DateTime  @db.Date
  note        String    @default("")
  createdById String?
  deletedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([category])
}

/// «يومية المحل»: quick sales written as they happen, settled later into one sale invoice per customer.
model DaybookEntry {
  id          String      @id @default(cuid())
  day         DateTime    @db.Date
  kind        DaybookKind @default(ITEM)
  productId   String?
  name        String
  qty         Decimal     @db.Decimal(14, 3)
  /// Unit price for an item, the amount for a payment.
  price       Decimal     @db.Decimal(14, 2)
  /// Pieces sold but not handed over yet («باقي له»); they stay in stock until delivered.
  owed        Decimal     @default(0) @db.Decimal(14, 3)
  person      String      @default("")
  pay         DaybookPay  @default(CASH)
  note        String      @default("")
  /// Quantity this line has taken out of stock so far (qty − undelivered owed).
  stockOut    Decimal     @default(0) @db.Decimal(14, 3)
  createdById String?
  deliveredAt DateTime?   @db.Timestamptz(3)
  postedAt    DateTime?   @db.Timestamptz(3)
  invoiceId   String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: Restrict)
  invoice     Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([day])
  @@index([invoiceId])
}

/// «🔒 تقفيل اليومية»: the day's figures frozen at closing time plus the cash actually counted.
model DayClosing {
  id           String   @id @default(cuid())
  day          DateTime @db.Date
  data         Json
  cashExpected Decimal  @db.Decimal(14, 2)
  cashActual   Decimal? @db.Decimal(14, 2)
  cashDiff     Decimal? @db.Decimal(14, 2)
  note         String   @default("")
  createdById  String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([day])
}

/// «🧮 الجرد»: one saved count (JR-0001…) with every counted line and the shortage/excess value.
model StockCount {
  id          String   @id @default(cuid())
  no          String   @unique
  note        String   @default("")
  items       Json
  itemCount   Int
  shortValue  Decimal  @db.Decimal(14, 2)
  excessValue Decimal  @db.Decimal(14, 2)
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
}
