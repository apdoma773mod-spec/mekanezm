generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  USER_CREATE
  USER_UPDATE
  USER_DEACTIVATE
  USER_PASSWORD_RESET
  SETTING_UPDATE
  PRODUCT_CREATE
  PRODUCT_UPDATE
  PRODUCT_DELETE
  STOCK_ADJUST
  CONTACT_CREATE
  CONTACT_UPDATE
  CONTACT_DELETE
  INVOICE_CREATE
  INVOICE_UPDATE
  INVOICE_VOID
  PAYMENT_CREATE
  PAYMENT_CANCEL
  RETURN_CREATE
  EXPENSE_CREATE
  EXPENSE_UPDATE
  EXPENSE_DELETE
  DAYBOOK_ADD
  DAYBOOK_UPDATE
  DAYBOOK_DELETE
  DAYBOOK_POST
  DAYBOOK_DELIVER
  DAY_CLOSE
  STOCK_COUNT
  DEBT_REMIND
  QUOTE_SAVE
  QUOTE_DELETE
  SHIP_SAVE
  SHIP_DELETE
  GIFT_CREATE
  GRADE_MOVE
  PRODUCT_ALTS
  STAFF_SAVE
  ATTENDANCE_SAVE
  STAFF_MOVE
  STAFF_POINTS
  KIT_SAVE
  KIT_DELETE
  SAMPLE_SAVE
  WANTED_SAVE
  IC_TRANSFER
  PARTNER_SAVE
  VEHICLE_SAVE
  FIELD_ORDER
  VAN_MOVE
  VAN_CLOSE
  CONTRACT_SAVE
  WA_SEND
}

enum Company {
  MK
  HY
}

enum ContactType {
  CUSTOMER
  SUPPLIER
}

enum InvoiceKind {
  SALE
  PURCHASE
}

enum InvoiceStatus {
  ACTIVE
  VOID
}

enum PayMethod {
  CASH
  INSTAPAY
  WALLET
  TRANSFER
}

enum PaymentDirection {
  IN
  OUT
}

enum ReturnKind {
  SALE
  PURCHASE
}

enum ReturnSettlement {
  CASH
  BALANCE
}

enum StockReason {
  SALE
  PURCHASE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUST
  INVOICE_EDIT
  INVOICE_VOID
  DAYBOOK
  COUNT
  GIFT
  GRADE
  SAMPLE
  VAN_CLOSE
}

enum DaybookKind {
  ITEM
  PAY
}

enum DaybookPay {
  CASH
  INSTAPAY
  TRANSFER
  CREDIT
}

model User {
  id           String         @id @default(cuid())
  name         String
  phone        String         @unique
  email        String?        @unique
  passwordHash String
  role         Role           @default(STAFF)
  active       Boolean        @default(true)
  lastLoginAt  DateTime?      @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  tokens       RefreshToken[]
  auditLogs    AuditLog[]
  settings     Setting[]
  stockMoves   StockMove[]
  invoicesMade Invoice[]      @relation("InvoiceCreatedBy")
  invoicesEdit Invoice[]      @relation("InvoiceUpdatedBy")
  invoicesVoid Invoice[]      @relation("InvoiceVoidedBy")
  payments     Payment[]      @relation("PaymentCreatedBy")
  paymentsOff  Payment[]      @relation("PaymentCancelledBy")
  returns      Return[]
  expenses     Expense[]
  daybook      DaybookEntry[]
  closings     DayClosing[]
  counts       StockCount[]
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  familyId   String
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  replacedBy String?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([action])
}

/// Gap-free number sequences: product codes, sale and purchase invoice numbers.
model Counter {
  key   String @id
  value Int    @default(0)
}

model Product {
  id        String         @id @default(cuid())
  /// Never reused, even after the product is deleted (soft delete keeps the row).
  code      String         @unique
  name      String
  barcode   String?        @unique
  category  String         @default("")
  unit      String         @default("قطعة")
  price     Decimal        @default(0) @db.Decimal(14, 2)
  cost      Decimal        @default(0) @db.Decimal(14, 2)
  /// «تقديري»: the cost was guessed from the sell price (💰 بضاعة قديمة) until a real purchase replaces it.
  costEst   Boolean        @default(false)
  qty       Decimal        @default(0) @db.Decimal(14, 3)
  minQty    Decimal        @default(0) @db.Decimal(14, 3)
  company   Company        @default(MK)
  note      String         @default("")
  deletedAt DateTime?      @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
  moves     StockMove[]
  items     InvoiceItem[]
  returns   Return[]
  daybook   DaybookEntry[]
  info      ProductInfo?

  @@index([name])
  @@index([category])
  @@index([company, deletedAt])
}

/// «شاشة المنتج»: الماركة والتشطيب والمقاس والمواصفات ومكانه في المحل والمجموعة والعبوات والصور (mk_product_info القديمة).
model ProductInfo {
  productId String   @id
  brand     String   @default("")
  finish    String   @default("")
  size      String   @default("")
  specs     String   @default("")
  loc       String   @default("")
  grp       String   @default("")
  descr     String   @default("")
  /// [{u:"علبة", n:12} | {u:"مسمار", n:0.004, x:250, small:true}]
  packs     Json     @default("[]")
  imgs      Json     @default("[]")
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([grp])
}

model StockMove {
  id        String      @id @default(cuid())
  productId String
  qtyChange Decimal     @db.Decimal(14, 3)
  qtyAfter  Decimal     @db.Decimal(14, 3)
  reason    StockReason
  refType   String?
  refId     String?
  note      String      @default("")
  userId    String?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([refType, refId])
}

model Contact {
  id             String      @id @default(cuid())
  type           ContactType
  name           String
  phone          String      @default("")
  address        String      @default("")
  note           String      @default("")
  /// Customer: what they owe us. Supplier: what we owe them. Kept in step with every invoice, payment and return.
  balance        Decimal     @default(0) @db.Decimal(14, 2)
  /// Balance carried over when the contact was added; the first line of the statement.
  openingBalance Decimal     @default(0) @db.Decimal(14, 2)
  deletedAt      DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  invoices       Invoice[]
  payments       Payment[]
  returns        Return[]

  @@index([type, name])
  @@index([phone])
}

model Invoice {
  id          String         @id @default(cuid())
  kind        InvoiceKind
  no          String
  status      InvoiceStatus  @default(ACTIVE)
  company     Company        @default(MK)
  /// Business day in Cairo time.
  date        DateTime       @db.Date
  contactId   String?
  person      String         @default("")
  phone       String         @default("")
  address     String         @default("")
  note        String         @default("")
  subtotal    Decimal        @db.Decimal(14, 2)
  discount    Decimal        @default(0) @db.Decimal(14, 2)
  shipping    Decimal        @default(0) @db.Decimal(14, 2)
  total       Decimal        @db.Decimal(14, 2)
  paid        Decimal        @db.Decimal(14, 2)
  remaining   Decimal        @db.Decimal(14, 2)
  payMethod   PayMethod      @default(CASH)
  /// When one invoice was paid with several methods (the daybook): { "CASH": 100, "INSTAPAY": 50 }.
  paidSplit   Json?
  /// "" for invoices typed in directly, "DAYBOOK" when made by settling the daybook.
  source      String         @default("")
  /// Sale to an online customer (Facebook / WhatsApp / site) — «🌐 عميل أونلاين» in the sale window.
  online      Boolean        @default(false)
  /// Where the online sale came from: SITE | WA | FB | IG | OTHER ("" = not said).
  onlineFrom  String         @default("")
  /// Inter-company deal: the other company, and the id shared by the sale and the purchase.
  ic          Company?
  icRef       String?
  createdById String?
  updatedById String?
  voidedById  String?
  voidedAt    DateTime?      @db.Timestamptz(3)
  voidReason  String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  contact     Contact?       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  createdBy   User?          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?          @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  voidedBy    User?          @relation("InvoiceVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  items       InvoiceItem[]
  payments    Payment[]
  returns     Return[]
  daybook     DaybookEntry[]

  @@unique([kind, no])
  @@index([kind, date])
  @@index([contactId])
  @@index([status])
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  productId String?
  name      String
  unit      String   @default("قطعة")
  qty       Decimal  @db.Decimal(14, 3)
  price     Decimal  @db.Decimal(14, 2)
  total     Decimal  @db.Decimal(14, 2)
  /// Cost per unit when the line was saved: product cost for a sale, the purchase price for a purchase.
  unitCost  Decimal  @db.Decimal(14, 2)
  position  Int
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id            String           @id @default(cuid())
  contactId     String
  invoiceId     String?
  direction     PaymentDirection
  amount        Decimal          @db.Decimal(14, 2)
  method        PayMethod        @default(CASH)
  company       Company          @default(MK)
  date          DateTime         @db.Date
  note          String           @default("")
  /// False for book-only settlements (e.g. zeroing an account without money changing hands).
  affectsCash   Boolean          @default(true)
  createdById   String?
  cancelledById String?
  cancelledAt   DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  contact       Contact          @relation(fields: [contactId], references: [id], onDelete: Restrict)
  invoice       Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy     User?            @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy   User?            @relation("PaymentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([contactId, date])
  @@index([date])
}

model Return {
  id          String           @id @default(cuid())
  kind        ReturnKind
  productId   String
  contactId   String?
  invoiceId   String?
  person      String           @default("")
  qty         Decimal          @db.Decimal(14, 3)
  price       Decimal          @db.Decimal(14, 2)
  total       Decimal          @db.Decimal(14, 2)
  unitCost    Decimal          @db.Decimal(14, 2)
  settlement  ReturnSettlement @default(CASH)
  method      PayMethod        @default(CASH)
  company     Company          @default(MK)
  date        DateTime         @db.Date
  note        String           @default("")
  createdById String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  contact     Contact?         @relation(fields: [contactId], references: [id], onDelete: Restrict)
  invoice     Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([productId])
}

model Expense {
  id          String    @id @default(cuid())
  category    String    @default("عام")
  amount      Decimal   @db.Decimal(14, 2)
  method      PayMethod @default(CASH)
  company     Company   @default(MK)
  date        DateTime  @db.Date
  note        String    @default("")
  createdById String?
  deletedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([category])
}

/// «يومية المحل»: quick sales written as they happen, settled later into one sale invoice per customer.
model DaybookEntry {
  id          String      @id @default(cuid())
  day         DateTime    @db.Date
  kind        DaybookKind @default(ITEM)
  productId   String?
  name        String
  qty         Decimal     @db.Decimal(14, 3)
  /// Unit price for an item, the amount for a payment.
  price       Decimal     @db.Decimal(14, 2)
  /// Pieces sold but not handed over yet («باقي له»); they stay in stock until delivered.
  owed        Decimal     @default(0) @db.Decimal(14, 3)
  person      String      @default("")
  pay         DaybookPay  @default(CASH)
  note        String      @default("")
  /// Quantity this line has taken out of stock so far (qty − undelivered owed).
  stockOut    Decimal     @default(0) @db.Decimal(14, 3)
  createdById String?
  deliveredAt DateTime?   @db.Timestamptz(3)
  postedAt    DateTime?   @db.Timestamptz(3)
  invoiceId   String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: Restrict)
  invoice     Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([day])
  @@index([invoiceId])
}

/// «🔒 تقفيل اليومية»: the day's figures frozen at closing time plus the cash actually counted.
model DayClosing {
  id           String   @id @default(cuid())
  day          DateTime @db.Date
  data         Json
  cashExpected Decimal  @db.Decimal(14, 2)
  cashActual   Decimal? @db.Decimal(14, 2)
  cashDiff     Decimal? @db.Decimal(14, 2)
  note         String   @default("")
  createdById  String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([day])
}

/// «🧮 الجرد»: one saved count (JR-0001…) with every counted line and the shortage/excess value.
model StockCount {
  id          String   @id @default(cuid())
  no          String   @unique
  note        String   @default("")
  items       Json
  itemCount   Int
  shortValue  Decimal  @db.Decimal(14, 2)
  excessValue Decimal  @db.Decimal(14, 2)
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

// ---------- Phase 4: quotes, shipping, gifts, staff, kits, samples, wanted ----------

/// «عرض سعر»: doesn't touch stock or reports; can be turned into a sale invoice.
model Quote {
  id          String   @id @default(cuid())
  no          String   @unique
  date        DateTime @db.Date
  person      String   @default("")
  phone       String   @default("")
  address     String   @default("")
  note        String   @default("")
  shipping    Decimal  @default(0) @db.Decimal(14, 2)
  total       Decimal  @default(0) @db.Decimal(14, 2)
  /// [{ productId, name, unit, qty, price, total }]
  items       Json
  /// open | converted
  status      String   @default("open")
  invoiceId   String?
  invoiceNo   String   @default("")
  createdById String?
  createdBy   String   @default("")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
}

enum ShipKind {
  SHIP
  DELIVERY
}

/// «الشحن والتوصيل»: one parcel from label printing until the money is collected.
model Shipment {
  id          String    @id @default(cuid())
  no          String    @unique
  kind        ShipKind  @default(SHIP)
  /// new | printed | handed | out | delivered | paid | returned | cancelled
  status      String    @default("new")
  invoiceId   String?
  invoiceNo   String    @default("")
  name        String
  phone       String    @default("")
  phone2      String    @default("")
  gov         String    @default("")
  area        String    @default("")
  address     String    @default("")
  carrier     String    @default("")
  tracking    String    @default("")
  driver      String    @default("")
  driverPhone String    @default("")
  cod         Decimal   @default(0) @db.Decimal(14, 2)
  fee         Decimal   @default(0) @db.Decimal(14, 2)
  pieces      Int       @default(1)
  content     String    @default("")
  note        String    @default("")
  /// [{ s: status, at: ISO time, by: name }]
  log         Json      @default("[]")
  closedAt    DateTime? @db.Timestamptz(3)
  createdById String?
  createdBy   String    @default("")
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([invoiceId])
}

/// «🎁 هدية»: stock given away to a craftsman or engineer, valued at sale price and cost.
model Gift {
  id          String   @id @default(cuid())
  productId   String
  productName String
  qty         Decimal  @db.Decimal(14, 3)
  price       Decimal  @db.Decimal(14, 2)
  cost        Decimal  @db.Decimal(14, 2)
  toName      String
  toPhone     String   @default("")
  toKind      String   @default("صنايعي")
  note        String   @default("")
  createdById String?
  createdBy   String   @default("")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([toName])
  @@index([createdAt])
}

/// «👷 العمالة»: an employee's file; `userId` links the system account that punches in with the QR.
model Staff {
  id         String       @id @default(cuid())
  name       String
  job        String       @default("")
  phone      String       @default("")
  nid        String       @default("")
  address    String       @default("")
  /// month | week | day
  payType    String       @default("month")
  salary     Decimal      @default(0) @db.Decimal(14, 2)
  shiftStart String       @default("10:00")
  shiftEnd   String       @default("22:00")
  /// 0 = Sunday … 6 = Saturday, -1 = none
  offDay     Int          @default(5)
  startDate  DateTime     @db.Date
  userId     String?      @unique
  note       String       @default("")
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)
  attendance Attendance[]
  moves      StaffMove[]
  points     StaffPoint[]
}

model Attendance {
  id        String    @id @default(cuid())
  staffId   String
  day       DateTime  @db.Date
  inAt      DateTime? @db.Timestamptz(3)
  outAt     DateTime? @db.Timestamptz(3)
  lateMin   Int       @default(0)
  /// qr | manual
  method    String    @default("qr")
  note      String    @default("")
  byName    String    @default("")
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, day])
  @@index([day])
}

/// advance | bonus | deduct | pay — advances and pay also create an expense.
model StaffMove {
  id          String   @id @default(cuid())
  staffId     String
  kind        String
  amount      Decimal  @db.Decimal(14, 2)
  /// YYYY-MM the move counts for
  month       String
  note        String   @default("")
  expenseId   String?
  createdById String?
  byName      String   @default("")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, month])
}

/// Hand-given points and redemptions; attendance points are computed, not stored.
model StaffPoint {
  id          String   @id @default(cuid())
  staffId     String
  pts         Int
  why         String   @default("")
  month       String
  redeem      Boolean  @default(false)
  createdById String?
  byName      String   @default("")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

/// The rotating QR code on the attendance screen (valid for a short time).
model PunchCode {
  code      String   @id
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

/// «🧩 الأطقم والتركيبات»: components bought apart and sold together.
model Kit {
  id        String   @id @default(cuid())
  code      String   @unique
  barcode   String   @unique
  name      String
  /// what the kit is counted in, e.g. «دلفة»
  param     String   @default("")
  def       Decimal  @default(1) @db.Decimal(14, 3)
  /// fixed sale price for the whole kit; null = sum of components
  sp        Decimal? @db.Decimal(14, 2)
  /// [{ label, mode: fixed|param|len, qty, per, ulen, opt, products: [id] }]
  slots     Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// «🧪 العينات»: out | returned | sold | lost. Stock leaves only when sold (invoice) or lost.
model Sample {
  id          String    @id @default(cuid())
  productId   String?
  productName String
  qty         Decimal   @db.Decimal(14, 3)
  customer    String    @default("")
  date        DateTime  @db.Date
  givenBy     String    @default("")
  status      String    @default("out")
  invoiceId   String?
  resolvedAt  DateTime? @db.Timestamptz(3)
  createdById String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([status])
}

/// «🔎 مطلوب ومش عندنا»: things customers asked for that the shop doesn't have.
model WantedItem {
  id        String   @id @default(cuid())
  descr     String
  thumb     String?
  source    String   @default("المحل")
  phone     String   @default("")
  byName    String   @default("")
  done      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([done])
}

// ---------- Phase 5: Hydrolek («🏢 الشركات») ----------

/// «🤝 الشركاء»: Hydrolek's partners and their fixed share of its profit.
model Partner {
  id        String        @id @default(cuid())
  name      String
  phone     String        @default("")
  share     Decimal       @default(0) @db.Decimal(6, 2)
  note      String        @default("")
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  moves     PartnerMove[]
}

/// capital (put money in) | draw (took money) | profit (we paid their share)
model PartnerMove {
  id        String   @id @default(cuid())
  partnerId String
  kind      String
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime @db.Date
  note      String   @default("")
  byName    String   @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

/// «🚗 السيارة»; `meta` holds owner, driver, licence/insurance/service dates and the next-service km.
model Vehicle {
  id        String       @id @default(cuid())
  name      String
  plate     String       @default("")
  meta      Json         @default("{}")
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  log       VehicleLog[]
}

/// One running cost; each also creates a Hydrolek expense «سيارة: <kind>».
model VehicleLog {
  id        String   @id @default(cuid())
  vehicleId String
  date      DateTime @db.Date
  kind      String
  amount    Decimal  @db.Decimal(14, 2)
  km        Decimal? @db.Decimal(12, 1)
  liters    Decimal? @db.Decimal(10, 2)
  note      String   @default("")
  expenseId String?
  byName    String   @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date])
}

/// «⚡ أوردر ميداني»: what the rep sold from the van now (s) and what is requested from Mekanizm (r), per line.
model FieldOrder {
  id        String    @id @default(cuid())
  no        String    @unique
  company   Company   @default(HY)
  date      DateTime  @db.Date
  customer  String
  phone     String    @default("")
  addr      String    @default("")
  eta       String    @default("")
  items     String    @default("")
  total     Decimal   @default(0) @db.Decimal(14, 2)
  note      String    @default("")
  rep       String    @default("")
  /// [{ pid, n, q, pr, wh, nw, d, img, pri, st, s, r, sd, inv, dm, dd, h: [{st, by, at}] }]
  lines     Json      @default("[]")
  /// new | doing | done | cancel
  status    String    @default("new")
  sentAt    DateTime? @db.Timestamptz(3)
  doneBy    String    @default("")
  wh        String    @default("")
  doneAt    DateTime? @db.Timestamptz(3)
  invoiceNo String    @default("")
  vehicleId String    @default("")
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([customer])
}

/// What is on the van now, per product and funder (a partner's capital or none).
model VanStock {
  id        String  @id @default(cuid())
  productId String
  name      String
  qty       Decimal @default(0) @db.Decimal(14, 3)
  cost      Decimal @default(0) @db.Decimal(14, 2)
  funder    String  @default("")

  @@unique([productId, funder])
}

/// load | sale | return | adjust | unload — qty is signed (sales and unloads are negative).
model VanMove {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  kind      String
  productId String
  name      String
  qty       Decimal  @db.Decimal(14, 3)
  /// mk | hy | partner
  src       String   @default("hy")
  funder    String   @default("")
  cost      Decimal  @default(0) @db.Decimal(14, 2)
  ref       String   @default("")
  note      String   @default("")
  vehicleId String   @default("")
  byName    String   @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([date])
  @@index([productId])
}

/// «🧾 تصفية آخر اليوم» for one van and day.
model VanClose {
  id           String    @id @default(cuid())
  date         DateTime  @db.Date
  vehicleId    String    @default("")
  closed       Boolean   @default(true)
  cash         Decimal   @default(0) @db.Decimal(14, 2)
  credit       Decimal   @default(0) @db.Decimal(14, 2)
  expenses     Decimal   @default(0) @db.Decimal(14, 2)
  expectedCash Decimal   @default(0) @db.Decimal(14, 2)
  handed       Decimal   @default(0) @db.Decimal(14, 2)
  diffValue    Decimal   @default(0) @db.Decimal(14, 2)
  note         String    @default("")
  data         Json      @default("{}")
  byName       String    @default("")
  closedAt     DateTime? @db.Timestamptz(3)
  reopenedBy   String    @default("")
  reopenedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([date, vehicleId])
}

/// «📑 العقود والعرابين»: a customer paid (contract or deposit) and we bring them work.
model Contract {
  id        String   @id @default(cuid())
  no        String   @unique
  client    String
  phone     String   @default("")
  kind      String   @default("عقد شغل")
  title     String
  total     Decimal  @default(0) @db.Decimal(14, 2)
  start     String   @default("")
  due       String   @default("")
  /// open | work | done | cancel
  status    String   @default("open")
  note      String   @default("")
  /// [{ id, date, amt, m, note, rec, by }]
  pays      Json     @default("[]")
  /// [{ id, date, amt, desc, by }]
  costs     Json     @default("[]")
  orders    Json     @default("[]")
  hist      Json     @default("[]")
  byName    String   @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// WhatsApp messages waiting for the shop PC's bridge (wa_out in the old system).
/// «طلبات الموقع»: an order a customer sent from the public shop page (items are {code, qty, backorder?}).
model WebOrder {
  id           String    @id @default(cuid())
  customerName String
  phone        String    @default("")
  items        Json
  /// new | done | cancelled
  status       String    @default("new")
  /// What the customer was told about pickup («بكره إن شاء الله»…).
  eta          String    @default("")
  invoiceNo    String?
  repliedAt    DateTime? @db.Timestamptz(3)
  handledAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
}

/// «📷 طلبات بالصور»: a customer sent a photo of a product he could not find on the site.
model WebRequest {
  id        String    @id @default(cuid())
  name      String
  phone     String    @default("")
  imgs      Json      @default("[]")
  note      String    @default("")
  /// new | replied | closed
  status    String    @default("new")
  reply     String    @default("")
  repliedAt DateTime? @db.Timestamptz(3)
  repliedBy String    @default("")
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
}

/// «🛠️ طلبات تجهيز من الموقع»: sizes for stainless, bamboo drawers or cabinet doors chosen on the site.
model WebCustom {
  id        String   @id @default(cuid())
  name      String
  phone     String   @default("")
  /// steel | bamboo | delf
  kind      String
  summary   String   @default("")
  note      String   @default("")
  img       String   @default("")
  spec      Json     @default("{}")
  /// new | opened | closed | cancelled
  status    String   @default("new")
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
}

/// 🔗 رابط العميل (mk_portal القديمة): a private link per customer; the page reads his account live.
model Portal {
  token     String   @id
  contactId String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

/// What the customer wrote (and the photos/videos he sent) from his link.
model PortalMsg {
  id        String   @id @default(cuid())
  contactId String
  body      String
  /// [{ u: url, t: "i" | "v" }]
  media     Json     @default("[]")
  seen      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([seen, createdAt])
  @@index([contactId, createdAt])
}

model OutboundMessage {
  id        String    @id @default(cuid())
  toPhone   String
  body      String
  /// queued | sent | failed
  status    String    @default("queued")
  err       String    @default("")
  byName    String    @default("")
  claimedAt DateTime? @db.Timestamptz(3)
  doneAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
}

// ---------- 📲 فلوس فودافون كاش (الموبايل بيبعت الرسالة على /sms/in) ----------
model SmsIn {
  id         String   @id @default(cuid())
  sender     String   @default("")
  amount     Decimal  @db.Decimal(14, 2)
  note       String   @default("")
  phone      String?
  /// in = استلمت، out = بعتّ
  direction  String?
  /// pending | used | ignored
  status     String   @default("pending")
  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([status, receivedAt])
}

// ---------- 💬 طلبات الواتساب (الجسر بيبعت الرسالة اللي فيها «طلب») ----------
model WaOrder {
  id           String    @id @default(cuid())
  msgId        String?   @unique
  phone        String    @default("")
  customerName String    @default("")
  body         String
  /// new | done | ignored | promoted
  status       String    @default("new")
  invoiceNo    String?
  handledAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
}

// ---------- 🖼️ صور الواتساب (تحويلات وتصاميم العملاء) ----------
model WaPhoto {
  id        String    @id @default(cuid())
  msgId     String?   @unique
  phone     String    @default("")
  name      String    @default("")
  caption   String    @default("")
  /// data:image/...;base64,...
  img       String    @db.Text
  seen      String    @default("")
  matches   Json      @default("[]")
  /// new | sent | missing | ignored | paid | transfer
  status    String    @default("new")
  handledBy String    @default("")
  handledAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
}

// ---------- 💾 النسخ الاحتياطية (نسخة كل يوم، آخر ٣١ يوم) ----------
model Backup {
  day    String   @id
  data   Json
  madeAt DateTime @default(now()) @db.Timestamptz(3)
}
