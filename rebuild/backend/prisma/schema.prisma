generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  USER_CREATE
  USER_UPDATE
  USER_DEACTIVATE
  USER_PASSWORD_RESET
  SETTING_UPDATE
}

model User {
  id           String         @id @default(cuid())
  name         String
  phone        String         @unique
  email        String?        @unique
  passwordHash String
  role         Role           @default(STAFF)
  active       Boolean        @default(true)
  lastLoginAt  DateTime?      @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  tokens       RefreshToken[]
  auditLogs    AuditLog[]
  settings     Setting[]
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  familyId   String
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  replacedBy String?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([action])
}
