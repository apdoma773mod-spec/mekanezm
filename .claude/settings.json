{
  "permissions": {
    "allow": [
      "Bash",
      "Bash(git push origin HEAD:main)",
      "Bash(skillspector scan:*)",
      "Edit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Write"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "mcp__Claude_Browser"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/skillspector.sh"
          }
        ]
      }
    ]
  }
}