<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>فحص الموقع</title>
<style>body{font-family:system-ui,sans-serif;padding:16px;background:#fff;color:#111}pre{white-space:pre-wrap;word-break:break-word;font-size:15px;line-height:1.8;direction:ltr;text-align:left}</style>
</head><body>
<h3>فحص shop.html</h3>
<pre id="o">جاري الفحص…</pre>
<script>
(function(){
var out=[],o=document.getElementById('o');
function log(s){out.push(s);o.textContent=out.join('\n')}
log('UA: '+navigator.userAgent);
fetch('shop.html?x='+Date.now(),{cache:'no-store'}).then(function(r){
  log('HTTP status: '+r.status+' | content-type: '+r.headers.get('content-type'));
  return r.text();
}).then(function(t){
  log('length (chars): '+t.length);
  log('starts with: '+JSON.stringify(t.slice(0,40)));
  log('ends with: '+JSON.stringify(t.slice(-30)));
  log('has state script: '+(t.indexOf('<script id="state"')>-1));
  log('has place_order: '+(t.indexOf('place_order')>-1));
  log('has code 1248: '+(t.indexOf('"code":"1248"')>-1));
  log('has </html>: '+(t.indexOf('</html>')>-1));
  var hook='<script>window.addEventListener("error",function(e){parent.postMessage({err:(e.message||"error")+" @line "+e.lineno+":"+e.colno},"*")});window.addEventListener("unhandledrejection",function(e){parent.postMessage({err:"promise: "+e.reason},"*")});<\/script>';
  var i=t.indexOf('<head>');
  var t2=i>-1?t.slice(0,i+6)+hook+t.slice(i+6):hook+t;
  window.addEventListener('message',function(e){if(e.data&&e.data.err)log('JS ERROR: '+e.data.err)});
  var f=document.createElement('iframe');
  f.style.cssText='width:1px;height:1px;border:0;position:absolute;left:-9999px';
  f.onload=function(){setTimeout(function(){
    try{var d=f.contentDocument;
      log('cards rendered: '+d.querySelectorAll('.card').length);
      log('body text length: '+(d.body?d.body.innerText.length:'no body'));
    }catch(e){log('iframe read error: '+e)}
    log('DONE');
  },1500)};
  f.srcdoc=t2;
  document.body.appendChild(f);
}).catch(function(e){log('FETCH ERROR: '+e)});
})();
</script></body></html>
